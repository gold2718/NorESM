## CMake and make tools
ARG CMAKE_VERSION=3.25.1
ENV CMAKE_MAJOR="${CMAKE_VERSION%[.][0-9]*}"
ENV CMAKE_VERSION=${CMAKE_VERSION}

RUN apt-get update --yes                          && \
    DEBIAN_FRONTEND=noninteractive                   \
    apt-get install --yes --no-install-recommends    \
    make                                             \
    pkg-config                                       \
    wget                                          && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir --parents /var/tmp                      && \
    wget -q -nc --no-check-certificate -P /var/tmp   \
         https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.sh && \
    mkdir --parents /usr/local                    && \
    /bin/sh /var/tmp/cmake-${CMAKE_VERSION}-linux-x86_64.sh --prefix=/usr/local --skip-license && \
    rm -rf /var/tmp/cmake-${CMAKE_VERSION}-linux-x86_64.sh
# End CMake tools

